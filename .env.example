# true = beta: sin login Google (mensaje en UI) y creación de equipo sin cargar chunk de Stripe
VITE_BETA_TESTERS_MODE=false

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_DATABASE_URL=your_database_url_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_numeric_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
VITE_FIREBASE_VAPID_KEY=your_web_push_certificate_public_key_here
CLOUDINARY_PRESET_INVENTARY=MetricWorkInventary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_PRESET=MetricWork
CLOUDINARY_PRESET_AVATAR=MetricWorkProfile
CLOUDINARY_API_PUBLIC=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Server-side push delivery on Vercel
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_service_account_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
# Optional alternative when the host has trouble preserving PEM newlines:
# FIREBASE_PRIVATE_KEY_BASE64=base64_encoded_service_account_private_key
