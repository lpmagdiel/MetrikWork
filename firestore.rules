rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS DE EQUIPO Y PERMISOS ---
    function teamExists(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId));
    }

    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    function isTeamMember(teamId) {
      return request.auth != null &&
             teamExists(teamId) &&
             request.auth.uid in teamData(teamId).members;
    }

    function isTeamAdmin(teamId) {
      return request.auth != null &&
             teamExists(teamId) &&
             request.auth.uid == teamData(teamId).admin;
    }

    function isSystemAdmin() {
      return request.auth != null &&
             request.auth.token.email is string &&
             request.auth.token.email in [
               "lpzcode@yahoo.com",
               "lopmag.lopez@gmail.com",
               "fabiansolares719@gmail.com"
             ];
    }

    function hasTeamPermission(teamId, module, action) {
      return isTeamAdmin(teamId) ||
             (
               isTeamMember(teamId) &&
               teamData(teamId).memberPermissions[request.auth.uid][module][action] == true
             );
    }

    function isValidTeamSize(size, maxMembers) {
      return size is string &&
             maxMembers is number &&
             (
               (size == "G" && maxMembers == 1) ||
               (size == "S" && maxMembers == 4) ||
               (size == "M" && maxMembers == 10) ||
               (size == "L" && maxMembers == 999)
             );
    }

    function respectsTeamMemberLimit(teamDocument) {
      return !teamDocument.keys().hasAny(["maxMembers"]) ||
             (
               teamDocument.maxMembers is number &&
               teamDocument.members.size() <= teamDocument.maxMembers
             );
    }

    function hasAvailableTeamMemberSlot(teamDocument) {
      return !teamDocument.keys().hasAny(["maxMembers"]) ||
             (
               teamDocument.maxMembers is number &&
               teamDocument.members.size() < teamDocument.maxMembers
             );
    }

    function isStatsBudgetUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["projectBudget", "projectBudgetCurrency", "updatedAt"]);
    }

    function isLocationBudgetUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["budget", "updatedAt"]);
    }

    function isAllowedTeamUpdateShape() {
      return request.resource.data.admin == resource.data.admin &&
             resource.data.admin in request.resource.data.members &&
             respectsTeamMemberLimit(request.resource.data) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "team",
               "adminEmail",
               "photoURL",
               "themePrimaryColor",
               "companyProfile",
               "overtimeLimitHours",
               "nonWorkingDays",
               "projectBudget",
               "projectBudgetCurrency",
               "billingDate",
               "customRoles",
               "memberSettings",
               "memberPermissions",
               "members",
               "membersData",
               "active",
               "hidden",
               "updatedAt"
             ]);
    }

    function isValidClientData(data) {
      return data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 120 &&
             (!("taxId" in data) || data.taxId is string) &&
             (!("email" in data) || data.email is string) &&
             (!("phone" in data) || data.phone is string) &&
             (!("address" in data) || data.address is string) &&
             (!("contactName" in data) || data.contactName is string) &&
             (!("notes" in data) || data.notes is string) &&
             (!("active" in data) || data.active is bool);
    }

    function isValidBudgetData(data) {
      return data.title is string &&
             data.title.size() > 0 &&
             data.amount is number &&
             data.amount >= 0 &&
             (!("description" in data) || data.description is string) &&
             (!("clientId" in data) || data.clientId is string) &&
             (!("clientName" in data) || data.clientName is string) &&
             (!("validUntil" in data) || data.validUntil is string) &&
             data.status in ["pending", "accepted", "rejected", "expired"];
    }

    function isValidChecklistItemData(data) {
      return data.title is string &&
             data.title.size() >= 2 &&
             data.title.size() <= 240 &&
             data.status in ["pending", "done"] &&
             data.includesLabor is bool &&
             data.includesMaterials is bool &&
             data.order is number &&
             (!("notes" in data) || data.notes is string) &&
             (!("assignedTo" in data) || data.assignedTo is string) &&
             (!("assignedToName" in data) || data.assignedToName is string) &&
             (!("completedAt" in data) || data.completedAt is string) &&
             (!("completedBy" in data) || data.completedBy is string);
    }

    function isAllowedTeamCreateShape() {
      return request.resource.data.keys().hasOnly([
               "team",
               "admin",
               "adminEmail",
               "members",
               "membersData",
               "memberPermissions",
               "projectBudget",
               "projectBudgetCurrency",
               "billingDate",
               "billingAmountEur",
               "teamSize",
               "maxMembers",
               "active",
               "createdAt"
             ]) &&
             request.resource.data.keys().hasAll([
               "team",
               "admin",
               "adminEmail",
               "members",
               "membersData",
               "memberPermissions",
               "projectBudget",
               "projectBudgetCurrency",
               "billingDate",
               "billingAmountEur",
               "teamSize",
               "maxMembers",
               "active",
               "createdAt"
             ]) &&
             request.resource.data.team is string &&
             request.resource.data.adminEmail == request.auth.token.email &&
             request.resource.data.members.size() == 1 &&
             request.auth.uid in request.resource.data.members &&
             request.resource.data.projectBudget is number &&
             request.resource.data.projectBudgetCurrency is string &&
             request.resource.data.billingAmountEur is number &&
             isValidTeamSize(request.resource.data.teamSize, request.resource.data.maxMembers) &&
             request.resource.data.members.size() <= request.resource.data.maxMembers &&
             (
               request.resource.data.billingDate == null ||
               request.resource.data.billingDate is string
             );
    }

    function isPresenceDocumentOwner(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.resource.data.uid == userId;
    }

    function isValidPresenceCreate(userId) {
      return isPresenceDocumentOwner(userId) &&
             request.resource.data.keys().hasOnly([
               "uid",
               "isOnline",
               "lastActiveAt",
               "lastSeenAt",
               "updatedAt"
             ]);
    }

    function isValidPresenceUpdate(userId) {
      return isPresenceDocumentOwner(userId) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "uid",
               "isOnline",
               "lastActiveAt",
               "lastSeenAt",
               "updatedAt"
             ]);
    }

    function teamInvitationAfter(teamId) {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/teamInvitations/$(teamId)).data;
    }

    function isAcceptingTeamInvitation(teamId) {
      return request.auth != null &&
             !(request.auth.uid in resource.data.members) &&
             request.auth.uid in request.resource.data.members &&
             request.resource.data.members.hasAll(resource.data.members) &&
             request.resource.data.members.size() == resource.data.members.size() + 1 &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "members",
               "membersData",
               "memberPermissions",
               "updatedAt"
             ]) &&
             teamInvitationAfter(teamId).teamId == teamId &&
             teamInvitationAfter(teamId).invitedUserId == request.auth.uid &&
             teamInvitationAfter(teamId).status == "aceptado" &&
             request.resource.data.memberPermissions[request.auth.uid] == teamInvitationAfter(teamId).permissions &&
             request.resource.data.membersData.hasAll(resource.data.membersData) &&
             request.resource.data.membersData.size() == resource.data.membersData.size() + 1;
    }

    function isSelfLeavingTeam(teamId) {
      return request.auth != null &&
             request.auth.uid != resource.data.admin &&
             request.auth.uid in resource.data.members &&
             !(request.auth.uid in request.resource.data.members) &&
             request.resource.data.admin == resource.data.admin &&
             resource.data.admin in request.resource.data.members &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "members",
               "membersData",
               "memberSettings",
               "memberPermissions",
               "updatedAt"
             ]) &&
             resource.data.members.hasAll(request.resource.data.members) &&
             request.resource.data.members.size() == resource.data.members.size() - 1 &&
             resource.data.membersData.hasAll(request.resource.data.membersData) &&
             request.resource.data.membersData.size() == resource.data.membersData.size() - 1 &&
             (
               !request.resource.data.keys().hasAny(["memberSettings"]) ||
               request.resource.data.memberSettings[request.auth.uid] == null
             ) &&
             (
               !request.resource.data.keys().hasAny(["memberPermissions"]) ||
               request.resource.data.memberPermissions[request.auth.uid] == null
             ) &&
             (
               !resource.data.keys().hasAny(["memberSettings"]) ||
               (
                 !request.resource.data.keys().hasAny(["memberSettings"]) &&
                 resource.data.memberSettings.keys().hasOnly([request.auth.uid])
               ) ||
               (
                 request.resource.data.keys().hasAny(["memberSettings"]) &&
                 resource.data.memberSettings.diff(request.resource.data.memberSettings)
                   .affectedKeys().hasOnly([request.auth.uid])
               )
             ) &&
             (
               !resource.data.keys().hasAny(["memberPermissions"]) ||
               (
                 !request.resource.data.keys().hasAny(["memberPermissions"]) &&
                 resource.data.memberPermissions.keys().hasOnly([request.auth.uid])
               ) ||
               (
                 request.resource.data.keys().hasAny(["memberPermissions"]) &&
                 resource.data.memberPermissions.diff(request.resource.data.memberPermissions)
                   .affectedKeys().hasOnly([request.auth.uid])
               )
             );
    }

    function isValidTeamInvitationDocument(data, userId, teamId) {
      return data.keys().hasOnly([
               "teamId",
               "teamName",
               "invitedUserId",
               "invitedUserEmail",
               "invitedUserName",
               "invitedUserPhotoURL",
               "invitedBy",
               "invitedByName",
               "permissions",
               "status",
               "createdAt",
               "updatedAt",
               "reviewedAt",
               "reviewedBy"
             ]) &&
             data.keys().hasAll([
               "teamId",
               "teamName",
               "invitedUserId",
               "invitedUserEmail",
               "invitedUserName",
               "invitedBy",
               "invitedByName",
               "permissions",
               "status",
               "createdAt",
               "updatedAt"
             ]) &&
             data.teamId == teamId &&
             data.invitedUserId == userId;
    }

    function canSendTeamInvitation(userId, teamId) {
      return request.auth != null &&
             request.auth.uid != userId &&
             teamExists(teamId) &&
             request.auth.uid in teamData(teamId).members &&
             !(userId in teamData(teamId).members) &&
             hasAvailableTeamMemberSlot(teamData(teamId)) &&
             (
               request.auth.uid == teamData(teamId).admin ||
               hasTeamPermission(teamId, "settings", "create") ||
               hasTeamPermission(teamId, "settings", "edit")
             );
    }

    function isTeamInvitationWrite(userId, teamId) {
      return canSendTeamInvitation(userId, teamId) &&
             isValidTeamInvitationDocument(request.resource.data, userId, teamId) &&
             request.resource.data.invitedBy == request.auth.uid &&
             request.resource.data.status == "pendiente";
    }

    function isTeamInvitationResponse(userId, teamId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             isValidTeamInvitationDocument(request.resource.data, userId, teamId) &&
             resource.data.status == "pendiente" &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "status",
               "updatedAt",
               "reviewedAt",
               "reviewedBy"
             ]) &&
             request.resource.data.status in ["aceptado", "rechazado"] &&
             request.resource.data.reviewedBy == request.auth.uid;
    }

    function isPrivateChatParticipant(chatId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/privateChats/$(chatId)) &&
             request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants;
    }

    function isValidPrivateChatCreate() {
      return request.auth != null &&
             request.resource.data.keys().hasAll(["teamId", "participants"]) &&
             request.resource.data.participants.size() == 2 &&
             request.auth.uid in request.resource.data.participants &&
             teamExists(request.resource.data.teamId) &&
             request.resource.data.participants[0] in teamData(request.resource.data.teamId).members &&
             request.resource.data.participants[1] in teamData(request.resource.data.teamId).members;
    }

    function isValidPrivateChatUpdate() {
      return request.auth != null &&
             request.auth.uid in resource.data.participants &&
             request.resource.data.teamId == resource.data.teamId &&
             request.resource.data.participants == resource.data.participants;
    }

    function isPublicUserProfileDocument(data) {
      return data.keys().hasOnly([
        "email",
        "emailNormalized",
        "name",
        "photoURL",
        "avatar",
        "createdAt",
        "lastLogin",
        "updatedAt"
      ]);
    }

    function isPublicUserProfileCreate() {
      return isPublicUserProfileDocument(request.resource.data);
    }

    function isPublicUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "email",
               "emailNormalized",
               "name",
               "photoURL",
               "avatar",
               "createdAt",
               "lastLogin",
               "updatedAt",
               "phone",
               "address",
               "iban",
               "bankName",
               "birthDate"
             ]) &&
             isPublicUserProfileDocument(request.resource.data);
    }

    function isUserPrivateProfileData() {
      return request.resource.data.keys().hasOnly([
        "phone",
        "address",
        "iban",
        "bankName",
        "birthDate",
        "updatedAt"
      ]);
    }

    function isTeamMemberPrivateProfileData() {
      return request.resource.data.keys().hasOnly([
        "phone",
        "iban",
        "bankName",
        "updatedAt"
      ]);
    }

    function isValidManualExpenseData(data) {
      return data.keys().hasOnly([
               "source",
               "title",
               "description",
               "category",
               "categoryLabel",
               "amount",
               "currency",
               "status",
               "method",
               "date",
               "dueDate",
               "paidAt",
               "vendorName",
               "vendorTaxId",
               "invoiceNumber",
               "locationId",
               "locationName",
               "deductible",
               "notes",
               "receipts",
               "createdBy",
               "createdByName",
               "createdAt",
               "updatedAt"
             ]) &&
             data.keys().hasAll([
               "source",
               "title",
               "description",
               "category",
               "categoryLabel",
               "amount",
               "currency",
               "status",
               "method",
               "date",
               "dueDate",
               "paidAt",
               "vendorName",
               "vendorTaxId",
               "invoiceNumber",
               "locationId",
               "locationName",
               "deductible",
               "notes",
               "receipts",
               "createdBy",
               "createdByName",
               "createdAt",
               "updatedAt"
             ]) &&
             data.source == "manual" &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 120 &&
             data.description is string &&
             data.description.size() <= 600 &&
             data.category in [
               "supplies",
               "transport",
               "food",
               "lodging",
               "rent",
               "utilities",
               "taxes",
               "tools",
               "maintenance",
               "insurance",
               "professional",
               "other"
             ] &&
             data.categoryLabel is string &&
             data.categoryLabel.size() <= 80 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.currency is string &&
             data.currency.matches("^[A-Z]{3}$") &&
             data.status in ["paid", "pending"] &&
             data.method in [
               "cash",
               "transfer",
               "card",
               "bizum",
               "direct_debit",
               "other"
             ] &&
             data.date is string &&
             data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             data.dueDate is string &&
             (
               data.dueDate == "" ||
               data.dueDate.matches("^\\d{4}-\\d{2}-\\d{2}$")
             ) &&
             data.paidAt is string &&
             (
               (
                 data.status == "paid" &&
                 data.paidAt.matches("^\\d{4}-\\d{2}-\\d{2}$")
               ) ||
               (
                 data.status == "pending" &&
                 data.paidAt == ""
               )
             ) &&
             data.vendorName is string &&
             data.vendorName.size() <= 120 &&
             data.vendorTaxId is string &&
             data.vendorTaxId.size() <= 40 &&
             data.invoiceNumber is string &&
             data.invoiceNumber.size() <= 80 &&
             data.locationId is string &&
             data.locationId.size() <= 120 &&
             data.locationName is string &&
             data.locationName.size() <= 120 &&
             data.deductible is bool &&
             data.notes is string &&
             data.notes.size() <= 1000 &&
             data.receipts is list &&
             data.receipts.size() <= 10 &&
             data.receipts.all(receipt,
               receipt.keys().hasOnly(["url", "name"]) &&
               receipt.url is string &&
               receipt.url.size() > 0 &&
               receipt.url.size() <= 600 &&
               receipt.name is string &&
               receipt.name.size() <= 160
             ) &&
             data.createdBy is string &&
             data.createdBy.size() > 0 &&
             data.createdByName is string &&
             data.createdByName.size() <= 120 &&
             data.createdAt is string &&
             data.createdAt.size() <= 40 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 40;
    }

    function isValidTeamPaymentData(data) {
      return data.keys().hasAll([
               "teamId",
               "userId",
               "amount",
               "type",
               "method",
               "date",
               "createdAt",
               "registeredBy",
               "registeredByName"
             ]) &&
             data.teamId is string &&
             teamExists(data.teamId) &&
             data.userId is string &&
             data.userId in teamData(data.teamId).members &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.type in ["total", "partial"] &&
             data.method in ["cash", "transfer", "bizum"] &&
             data.date is string &&
             data.createdAt is string &&
             data.registeredBy is string &&
             data.registeredByName is string &&
             data.registeredByName.size() <= 120;
    }

    function isNotificationPreferencesData(data) {
      return data.keys().hasOnly([
               "privateChats",
               "groupChats",
               "calls",
               "events",
               "tasks",
               "requests",
               "inventory",
               "payments",
               "updatedAt"
             ]) &&
             (!data.keys().hasAny(["privateChats"]) || data.privateChats is bool) &&
             (!data.keys().hasAny(["groupChats"]) || data.groupChats is bool) &&
             (!data.keys().hasAny(["calls"]) || data.calls is bool) &&
             (!data.keys().hasAny(["events"]) || data.events is bool) &&
             (!data.keys().hasAny(["tasks"]) || data.tasks is bool) &&
             (!data.keys().hasAny(["requests"]) || data.requests is bool) &&
             (!data.keys().hasAny(["inventory"]) || data.inventory is bool) &&
             (!data.keys().hasAny(["payments"]) || data.payments is bool);
    }

    // --- USUARIOS ---
    match /users/{userId} {
      // Necesario para ver miembros y buscar usuarios por email.
      allow read: if request.auth != null &&
                  (
                    request.auth.uid == userId ||
                    isSystemAdmin() ||
                    isPublicUserProfileDocument(resource.data)
                  );

      // Solo el usuario puede escribir su perfil público, sin datos sensibles.
      allow create: if request.auth != null &&
                    request.auth.uid == userId &&
                    isPublicUserProfileCreate();
      allow update: if request.auth != null &&
                    request.auth.uid == userId &&
                    isPublicUserProfileUpdate();
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /private/{privateDocId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null &&
                              request.auth.uid == userId &&
                              privateDocId == "profile" &&
                              isUserPrivateProfileData();
      }

      match /settings/{settingsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notificationPreferences/{preferencesId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null &&
                              request.auth.uid == userId &&
                              preferencesId == "default" &&
                              isNotificationPreferencesData(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /locations/{locationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pushTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /teamInvitations/{teamId} {
        allow read: if request.auth != null &&
                    (
                      request.auth.uid == userId ||
                      hasTeamPermission(teamId, "settings", "view") ||
                      hasTeamPermission(teamId, "settings", "create") ||
                      hasTeamPermission(teamId, "settings", "edit")
                    );
        allow create: if isTeamInvitationWrite(userId, teamId);
        allow update: if (
                        isTeamInvitationWrite(userId, teamId) &&
                        resource.data.status != "aceptado"
                      ) ||
                      isTeamInvitationResponse(userId, teamId);
        allow delete: if request.auth != null &&
                      (
                        request.auth.uid == userId ||
                        hasTeamPermission(teamId, "settings", "delete")
                      );
      }
    }

    // --- PRESENCIA EN LA APP ---
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow create: if isValidPresenceCreate(userId);
      allow update: if isValidPresenceUpdate(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- EQUIPOS ---
    match /teams/{teamId} {
      // Solo miembros pueden leer el equipo.
      allow read: if request.auth != null &&
                  request.auth.uid in resource.data.members;

      // Solo los administradores configurados pueden crear equipos.
      allow create: if isSystemAdmin() &&
                    request.resource.data.admin == request.auth.uid &&
                    request.auth.uid in request.resource.data.members &&
                    isAllowedTeamCreateShape();

      // El admin siempre puede actualizar. Miembros con permisos de ajustes
      // pueden agregar/editar configuración del equipo, pero no cambiar el admin.
      allow update: if request.auth != null &&
                    isAllowedTeamUpdateShape() &&
                    (
                      request.auth.uid == resource.data.admin ||
                      hasTeamPermission(teamId, "settings", "create") ||
                      hasTeamPermission(teamId, "settings", "edit") ||
                      hasTeamPermission(teamId, "settings", "delete") ||
                      (
                        hasTeamPermission(teamId, "stats", "edit") &&
                        isStatsBudgetUpdate()
                      ) ||
                      (
                        (
                          hasTeamPermission(teamId, "payments", "create") ||
                          hasTeamPermission(teamId, "payments", "edit")
                        ) &&
                        isStatsBudgetUpdate()
                      ) ||
                      isAcceptingTeamInvitation(teamId) ||
                      isSelfLeavingTeam(teamId)
                    );

      // Solo el administrador puede eliminar el equipo.
      allow delete: if request.auth != null &&
                    request.auth.uid == resource.data.admin;

      // --- SUBCOLECCIONES DE EQUIPO ---
      match /tasks/{taskId} {
        allow read: if hasTeamPermission(teamId, "tasks", "view") ||
                    (
                      isTeamMember(teamId) &&
                      request.auth.uid in resource.data.assignedTo
                    );
        allow create: if hasTeamPermission(teamId, "tasks", "create");
        allow update: if hasTeamPermission(teamId, "tasks", "edit");
        allow delete: if hasTeamPermission(teamId, "tasks", "delete");
      }

      match /inventory/{productId} {
        allow read: if hasTeamPermission(teamId, "inventory", "view") ||
                    hasTeamPermission(teamId, "stats", "view");
        allow create: if hasTeamPermission(teamId, "inventory", "create");
        allow update: if hasTeamPermission(teamId, "inventory", "edit");
        allow delete: if hasTeamPermission(teamId, "inventory", "delete");
      }

      match /inventoryMovements/{movementId} {
        allow read: if hasTeamPermission(teamId, "inventory", "view") ||
                    hasTeamPermission(teamId, "stats", "view");
        allow create: if hasTeamPermission(teamId, "inventory", "create") ||
                      hasTeamPermission(teamId, "inventory", "edit") ||
                      hasTeamPermission(teamId, "inventory", "delete");
        allow update, delete: if false;
      }

      match /galleryFolders/{folderId} {
        allow read, create, update, delete: if isTeamMember(teamId);
      }

      match /galleryImages/{imageId} {
        allow read, create, update, delete: if isTeamMember(teamId);
      }

      match /galleryMeta/{metaId} {
        allow read, create, update, delete: if isTeamMember(teamId);
      }

      match /templates/{templateId} {
        allow read: if isTeamMember(teamId);
        allow create: if isTeamMember(teamId) &&
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.type in ["task", "workday"];
        allow update, delete: if isTeamAdmin(teamId) ||
                              resource.data.createdBy == request.auth.uid;
      }

      match /locations/{locationId} {
        allow read: if isTeamMember(teamId);
        allow create: if hasTeamPermission(teamId, "locations", "create") ||
                      hasTeamPermission(teamId, "settings", "create") ||
                      hasTeamPermission(teamId, "inventory", "create");
        allow update: if hasTeamPermission(teamId, "locations", "edit") ||
                      hasTeamPermission(teamId, "settings", "edit") ||
                      hasTeamPermission(teamId, "inventory", "edit") ||
                      (
                        (
                          hasTeamPermission(teamId, "payments", "create") ||
                          hasTeamPermission(teamId, "payments", "edit")
                        ) &&
                        isLocationBudgetUpdate()
                      );
        allow delete: if hasTeamPermission(teamId, "locations", "delete") ||
                      hasTeamPermission(teamId, "settings", "delete") ||
                      hasTeamPermission(teamId, "inventory", "delete");
      }

      match /charges/{chargeId} {
        allow read: if hasTeamPermission(teamId, "payments", "view") ||
                    hasTeamPermission(teamId, "stats", "view");
        allow create: if hasTeamPermission(teamId, "payments", "create");
        allow update: if hasTeamPermission(teamId, "payments", "edit") ||
                      hasTeamPermission(teamId, "payments", "create");
        allow delete: if hasTeamPermission(teamId, "payments", "delete");
      }

      match /expenses/{expenseId} {
        allow read: if hasTeamPermission(teamId, "payments", "view") ||
                    hasTeamPermission(teamId, "stats", "view");
        allow create: if hasTeamPermission(teamId, "payments", "create") &&
                      request.resource.data.createdBy == request.auth.uid &&
                      isValidManualExpenseData(request.resource.data);
        allow update: if (
                        hasTeamPermission(teamId, "payments", "edit") ||
                        (
                          hasTeamPermission(teamId, "payments", "create") &&
                          resource.data.createdBy == request.auth.uid
                        )
                      ) &&
                      request.resource.data.source == resource.data.source &&
                      request.resource.data.createdBy == resource.data.createdBy &&
                      request.resource.data.createdByName == resource.data.createdByName &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isValidManualExpenseData(request.resource.data);
        allow delete: if hasTeamPermission(teamId, "payments", "delete");
      }

      match /chargeTemplates/{templateId} {
        allow read: if hasTeamPermission(teamId, "payments", "view") ||
                    hasTeamPermission(teamId, "payments", "create");
        allow create: if hasTeamPermission(teamId, "payments", "create");
        allow update, delete: if isTeamAdmin(teamId) ||
                              resource.data.createdBy == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read, write: if isTeamMember(teamId);
      }

      match /privateMemberProfiles/{userId} {
        allow read: if request.auth != null &&
                    (
                      request.auth.uid == userId ||
                      isTeamAdmin(teamId) ||
                      hasTeamPermission(teamId, "payments", "view") ||
                      hasTeamPermission(teamId, "payments", "edit")
                    );
        allow create, update: if request.auth != null &&
                              request.auth.uid == userId &&
                              isTeamMember(teamId) &&
                              isTeamMemberPrivateProfileData();
        allow delete: if request.auth != null &&
                      (
                        request.auth.uid == userId ||
                        isTeamAdmin(teamId)
                      );
      }
    }

    // Cada enlace compartido usa un token aleatorio como id. Se permite obtener
    // un documento concreto, pero nunca listar o enumerar las galerías públicas.
    match /galleryShares/{shareToken} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null &&
                    isTeamMember(request.resource.data.teamId);
      allow update: if request.auth != null &&
                    isTeamMember(resource.data.teamId) &&
                    request.resource.data.teamId == resource.data.teamId;
      allow delete: if request.auth != null &&
                    isTeamMember(resource.data.teamId);
    }

    // --- CHATS PRIVADOS ---
    match /privateChats/{chatId} {
      allow read, delete: if request.auth != null &&
                           request.auth.uid in resource.data.participants;

      allow create: if isValidPrivateChatCreate();

      allow update: if isValidPrivateChatUpdate();

      match /messages/{messageId} {
        allow read, write: if isPrivateChatParticipant(chatId);
      }

      match /calls/{callId} {
        allow read, write: if isPrivateChatParticipant(chatId);

        match /{candidateCollection}/{candidateId} {
          allow read, write: if isPrivateChatParticipant(chatId) &&
                             (candidateCollection == "callerCandidates" ||
                              candidateCollection == "receiverCandidates");
        }
      }
    }

    // --- TAREAS GLOBALES ---
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null &&
                                  request.auth.uid in resource.data.assignedTo;
      allow create: if request.auth != null;
    }

    // --- NOTIFICACIONES ---
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null &&
                                  request.auth.uid == resource.data.notificationFor;

      allow create: if request.auth != null;
    }

    // --- SOLICITUDES DE AUSENCIA ---
    match /absenceRequests/{requestId} {
      allow read: if request.auth != null &&
                  (
                    request.auth.uid == resource.data.requesterId ||
                    request.auth.uid == resource.data.adminId ||
                    (
                      resource.data.status == "aceptado" &&
                      hasTeamPermission(resource.data.teamId, "stats", "view")
                    )
                  );

      allow create: if request.auth != null &&
                    teamExists(request.resource.data.teamId) &&
                    request.auth.uid == request.resource.data.requesterId &&
                    request.auth.uid in teamData(request.resource.data.teamId).members &&
                    request.resource.data.adminId == teamData(request.resource.data.teamId).admin &&
                    request.resource.data.status == "pendiente";

      allow update: if request.auth != null &&
                    request.auth.uid == resource.data.adminId &&
                    resource.data.status == "pendiente" &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(["status", "updatedAt", "reviewedAt", "reviewedBy"]) &&
                    request.resource.data.status in ["aceptado", "rechazado"] &&
                    request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if false;
    }

    // --- TRABAJOS (Workdays) ---
    match /works/{workId} {
      // El usuario puede leer sus jornadas. Quien tenga permiso de ver pagos
      // puede leer jornadas del equipo para calcular balances. Permitimos get
      // de documentos inexistentes para que las transacciones puedan reservar
      // ids deterministas antes de crear la jornada.
      allow get: if request.auth != null &&
                 (
                   !exists(/databases/$(database)/documents/works/$(workId)) ||
                   request.auth.uid == resource.data.userId ||
                   hasTeamPermission(resource.data.teamId, "stats", "view") ||
                   hasTeamPermission(resource.data.teamId, "payments", "view")
                 );

      allow list: if request.auth != null &&
                  (
                    request.auth.uid == resource.data.userId ||
                    hasTeamPermission(resource.data.teamId, "stats", "view") ||
                    hasTeamPermission(resource.data.teamId, "payments", "view")
                  );

      // El usuario puede registrar su propio trabajo. El admin también puede
      // crear registros para miembros del equipo.
      allow create: if request.auth != null &&
                    teamExists(request.resource.data.teamId) &&
                    (
                      (
                        request.auth.uid == request.resource.data.userId &&
                        request.auth.uid in teamData(request.resource.data.teamId).members
                      ) ||
                      request.auth.uid == teamData(request.resource.data.teamId).admin
                    );

      // El usuario puede actualizar/borrar su propio registro. El admin puede
      // actualizar/borrar cualquier registro del equipo.
      allow update, delete: if request.auth != null &&
                            (
                              request.auth.uid == resource.data.userId ||
                              request.auth.uid == teamData(resource.data.teamId).admin
                            );
    }

    // --- PAGOS DEL EQUIPO (Team Payments) ---
    match /team_payments/{paymentId} {
      allow read: if request.auth != null &&
                  (
                    request.auth.uid == resource.data.userId ||
                    hasTeamPermission(resource.data.teamId, "payments", "view") ||
                    hasTeamPermission(resource.data.teamId, "stats", "view")
                  );
      allow create: if hasTeamPermission(request.resource.data.teamId, "payments", "create") &&
                    request.resource.data.registeredBy == request.auth.uid &&
                    isValidTeamPaymentData(request.resource.data);
      allow update: if hasTeamPermission(resource.data.teamId, "payments", "edit") &&
                    request.resource.data.teamId == resource.data.teamId &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.amount is number &&
                    request.resource.data.amount > 0 &&
                    request.resource.data.amount <= 1000000000;
      allow delete: if hasTeamPermission(resource.data.teamId, "payments", "delete");
    }

    // --- CLIENTES DE LA EMPRESA (globales, no ligados a un equipo) ---
    // La app pertenece a una sola empresa constructora. Los clientes son
    // relaciones comerciales compartidas y todos los miembros de los
    // equipos pueden consultarlos. La creación/edición/eliminación está
    // reservada al administrador de la empresa para evitar duplicados
    // y mantener la calidad del maestro de clientes.
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow create: if isSystemAdmin() &&
                    isValidClientData(request.resource.data);
      allow update: if isSystemAdmin() &&
                    isValidClientData(request.resource.data);
      allow delete: if isSystemAdmin();
    }

    // --- PRESUPUESTOS DE LA EMPRESA (globales, no ligados a un equipo) ---
    // Los presupuestos son documentos comerciales compartidos. Cualquier
    // miembro puede verlos para entender las ofertas activas. Solo el
    // administrador de la empresa puede crearlos, editarlos o
    // eliminarlos para garantizar coherencia.
    match /budgets/{budgetId} {
      allow read: if request.auth != null;
      allow create: if isSystemAdmin() &&
                    isValidBudgetData(request.resource.data);
      allow update: if isSystemAdmin() &&
                    isValidBudgetData(request.resource.data);
      allow delete: if isSystemAdmin();

      // Checklist asociado al presupuesto. Solo el system admin puede
      // crear/editar/eliminar items para mantener la coherencia con la
      // política del documento padre. Los items se renderizan también
      // en el PDF exportado del presupuesto.
      match /checklist/{itemId} {
        allow read: if request.auth != null;
        allow create: if isSystemAdmin() &&
                      isValidChecklistItemData(request.resource.data);
        allow update: if isSystemAdmin() &&
                      isValidChecklistItemData(request.resource.data);
        allow delete: if isSystemAdmin();
      }
    }
  }
}
